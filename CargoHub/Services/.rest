// maak een item om mee te werken
POST http://localhost:3000/api/v2/items
Content-Type:  application/json

{
  "Uid": "Item1"
}

#####
// Maak een inventory met 10x van item: Item1
POST http://localhost:3000/api/v2/inventories
Content-Type:  application/json

{
  "ItemId": "Item1",
  "total_on_hand": 10,
  "total_expected": 0,
  "total_ordered": 0,
  "total_allocated": 0,
  "total_available": 10
}


#####
// probeer een order te plaatsen voor 20x van item: Item1
POST http://localhost:3000/api/v2/orders
Content-Type: application/json

{
  "OrderStatus" : "Pending",
  "Items": [
    {
      "ItemUid": "Item1",
      "Amount": 20,
      "OrderId": 1
    }
  ]
}

####
// stuur een shipment met items naar de inventory met item: "Item1"
POST http://localhost:3000/api/v2/shipments
Content-Type: application/json

{
  "ShipmentType" : "I",
  "ShipmentStatus" : "Pending",
  "Items": [
    {
      "Id": 1,
      "ItemUid": "Item1",
      "Amount": 20,
      "ShipmentId": 1
    }
  ]
}

####
// zet het naar Transit
Put http://localhost:3000/api/v2/shipments/1
Content-Type: application/json

{
  "ShipmentType" : "I",
  "ShipmentStatus" : "Transit",
  "Items": [
    {
      "Id": 1,
      "ItemUid": "Item1",
      "Amount": 20,
      "ShipmentId": 1
    }
  ]
}

